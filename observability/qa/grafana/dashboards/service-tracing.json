{
  "uid": "dhanman-service-tracing",
  "title": "Dhanman \u2014 Service Tracing",
  "tags": [
    "dhanman",
    "tracing",
    "tempo"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "efm1ca74j8oaod"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total, service)",
          "refId": "service"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "efm1ca74j8oaod"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efm1ca74j8oaod"
          },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"OPTIONS\"}[5m]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "efm1ca74j8oaod"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efm1ca74j8oaod"
          },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"OPTIONS\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"OPTIONS\"}[5m])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "efm1ca74j8oaod"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efm1ca74j8oaod"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"OPTIONS\"}[5m])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Errors (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "efm1ca74j8oaod"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efm1ca74j8oaod"
          },
          "expr": "sum(increase(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"OPTIONS\", status_code=\"STATUS_CODE_ERROR\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 4,
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Requests / sec by service",
      "datasource": {
        "type": "prometheus",
        "uid": "efm1ca74j8oaod"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efm1ca74j8oaod"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"OPTIONS\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Errors / sec by service (5xx and exceptions)",
      "datasource": {
        "type": "prometheus",
        "uid": "efm1ca74j8oaod"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efm1ca74j8oaod"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"OPTIONS\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "p95 latency by service",
      "datasource": {
        "type": "prometheus",
        "uid": "efm1ca74j8oaod"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efm1ca74j8oaod"
          },
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"OPTIONS\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Slowest endpoints (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "efm1ca74j8oaod"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efm1ca74j8oaod"
          },
          "expr": "topk(20, histogram_quantile(0.95, sum by (service, span_name, le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"OPTIONS\"}[$__rate_interval]))))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service": "Service",
              "span_name": "Endpoint",
              "Value": "p95"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Endpoints with most errors (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "efm1ca74j8oaod"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efm1ca74j8oaod"
          },
          "expr": "topk(20, sum by (service, span_name) (increase(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"OPTIONS\", status_code=\"STATUS_CODE_ERROR\"}[$__range])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service": "Service",
              "span_name": "Endpoint",
              "Value": "Errors"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Errors",
            "desc": true
          }
        ]
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Recent failed requests \u2014 click a Trace ID to open it",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 50,
          "tableType": "traces",
          "query": "{ resource.service.name =~ \"${service:regex}\" && status = error }"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Slow requests (> 2s)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 50,
          "tableType": "traces",
          "query": "{ resource.service.name =~ \"${service:regex}\" && kind = server && duration > 2s }"
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "nodeGraph",
      "title": "Service map (who calls whom)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "serviceMap"
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 14
      }
    }
  ]
}
